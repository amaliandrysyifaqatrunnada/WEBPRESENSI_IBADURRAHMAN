APP_NAME="Presensi PKBM Ibadurrahman"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://presensi-pkbm-ibadurrahman.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database Cloud (Isi dengan kredensial MySQL Cloud Anda, misal: TiDB Serverless / Aiven / Railway)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Session & Cache (Gunakan database agar sesi tersimpan secara terpusat antar serverless invocations)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Filesystem
FILESYSTEM_DISK=local

# Vercel Serverless Cache Paths (Diarahkan ke /tmp writable directory)
VIEW_COMPILED_PATH=/tmp/storage/framework/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php

